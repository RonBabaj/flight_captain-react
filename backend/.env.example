# ──────────────────────────────────────────────────────────────────────────────
# Fly-Fix Web — Backend Environment Variables
# Copy this file to .env and fill in your keys.
# ──────────────────────────────────────────────────────────────────────────────

# ─── Server ───────────────────────────────────────────────────────────────────
# Port the backend listens on (defaults to 8080 if not set)
PORT=8080

# ─── Flight providers ─────────────────────────────────────────────────────────
# Comma-separated list of enabled search providers.
# Default (when unset): googleflights2
# Examples:
#   FLIGHT_PROVIDERS=googleflights2
#   FLIGHT_PROVIDERS=multisite
#   FLIGHT_PROVIDERS=googleflights2,multisite
# FLIGHT_PROVIDERS=googleflights2,multisite

# ─── Budget mode (recommended for personal / low-volume hosting) ───────────────
# Cuts API spend: longer in-process cache, lower GF2 rate limit, caps metro
# fan-out (TYO/NYC/LON), skips extra return-leg GF2 enrich calls, smaller Explore
# batches, and disables multisite OTA scraper unless you opt back in.
#
# Typical production .env on a VPS:
#   FLIGHT_BUDGET_MODE=1
#   FLIGHT_PROVIDERS=googleflights2
#
# FLIGHT_BUDGET_MODE=1
# FLIGHT_BUDGET_KEEP_KIWI=1          # set 1 to still run multisite scraper in budget mode
# GOOGLEFLIGHTS2_CACHE_TTL_MIN=45    # default 45 in budget mode, 10 when off
# GOOGLEFLIGHTS2_RATE_LIMIT_PER_MIN=15
# GF2_METRO_MAX_AIRPORTS=2           # max parallel airport codes per metro side
# GF2_METRO_CONCURRENCY=1
# FLIGHT_BUDGET_RT_ENRICH=0          # skip costly return-leg enrich (0 = skip in budget)
# EXPLORE_LIVE_FETCHES_PER_REQUEST=6
# FLIGHT_SEARCH_TRANSIENT_RETRIES=1  # fewer duplicate SearchAll() on blips

# ─── Google Flights2 (RapidAPI) ───────────────────────────────────────────────
# Subscribe to a "Google Flights2" style API on https://rapidapi.com and set:
GOOGLEFLIGHTS2_ENABLED=true
GOOGLEFLIGHTS2_RAPIDAPI_KEY=
GOOGLEFLIGHTS2_RAPIDAPI_HOST=google-flights2.p.rapidapi.com
# GOOGLEFLIGHTS2_ENDPOINT_PATH=        # Override the API path (advanced, rarely needed)
# GOOGLEFLIGHTS2_RATE_LIMIT_PER_MIN=30
# Uses an in-process cache (~10 min) and per-minute rate limit by default.

# ─── Multisite OTA scraper (self-hosted) ───────────────────────────────────────
# Playwright service: Kiwi + Skyscanner + Expedia (see services/flight-scraper/).
# GF2 (RapidAPI) = Google Flights half; multisite = OTA half.
#
#   FLIGHT_PROVIDERS=googleflights2,multisite
#   FLIGHT_SCRAPER_URL=http://flight-scraper:3099   # set by docker-compose on VPS
# FLIGHT_SCRAPER_SITES=kiwi,skyscanner,expedia
# FLIGHT_SCRAPER_TOKEN=                          # optional shared secret
# SCRAPER_PROXY_URL=                             # residential sticky proxy — required for reliable OTA scrape from VPS
# SCRAPER_SESSION_RETRIES=3
# KIWI_USE_TEQUILA=1                             # optional; KIWI_TEQUILA_API_KEY only if you enable this
# FLIGHT_SCRAPER_ENABLED=1                       # use default docker URL if URL unset

# ─── Booking link mode ───────────────────────────────────────────────────────
# Controls the fallback when a GF2 partner checkout URL cannot be resolved.
# Default: google_prefill (matches Google Flights data source).
# Options: google_prefill | skyscanner_prefill | direct_provider
# BOOKING_LINK_MODE=google_prefill

# ─── Affiliate tracking (optional) ──────────────────────────────────────────
# Used in outbound booking links for commission tracking.
# Set AFFILIATE_ID for a default; use per-provider overrides as needed.
# Do NOT commit real affiliate IDs to source control.
AFFILIATE_ID=
# AFF_ID_OTA=
# AFF_ID_LY=
# AFF_ID_UA=
# AFF_ID_AA=
# AFF_ID_BA=
# AFF_ID_LH=
# AFF_ID_TK=
# AFF_ID_EK=
# AFF_ID_DL=

# ─── Admin account (recommended) ─────────────────────────────────────────────
# On first startup, creates an admin user if none exists with this email.
# Set ADMIN_TEMP_PASSWORD via your host secrets manager — never commit a real value.
# Bootstrap runs once per email. To reset the password from env after changing it, set
# ADMIN_SYNC_BOOTSTRAP_PASSWORD=1, restart the API, sign in, then unset the flag.
# ADMIN_EMAIL=admin@fly-fix.com
# ADMIN_TEMP_PASSWORD=
# ADMIN_SYNC_BOOTSTRAP_PASSWORD=0
# Set to 0/false/no to disable public self-registration (admin can still create users).
# ALLOW_PUBLIC_REGISTRATION=1

# ─── Legacy admin token (optional, deprecated) ─────────────────────────────────
# Still works for API tools; the UI uses email/password login instead.
# ADMIN_TOKEN=your-secret-admin-token-here

# ─── Optional price uplift for GF2 results (percent) ──────────────────────────
# Off by default so listed fares match the Google Flights / provider quote.
# Set e.g. SEARCH_PRICE_UPLIFT_PCT=20 to show a +20% estimated checkout total.
# SEARCH_PRICE_UPLIFT_PCT=0

# ─── Web search (booking matcher) ─────────────────────────────────────────────
# Enables the Flight Booking Matcher pipeline (Google Flights itinerary → web search → verified offer).
# WEB_SEARCH_ENABLED=true   # Optional: auto-enabled when SERPAPI_API_KEY is set
# WEB_SEARCH_ENABLED=false  # Set explicitly to disable SerpAPI even when key is present
# SerpAPI Google Search JSON API: https://serpapi.com/
# SERPAPI_API_KEY=
# WEB_SEARCH_API_KEY=              # Alias for SERPAPI_API_KEY
# SERPAPI_ENGINE=google
# WEB_SEARCH_MAX_QUERIES=5
# WEB_SEARCH_MAX_CANDIDATES=20
# WEB_SEARCH_TIMEOUT_SEC=15
# BOOKING_MATCH_VERIFY_THRESHOLD=70
# BOOKING_RESOLVE_CACHE_TTL_MIN=30
# BOOKING_RESOLVE_NEGATIVE_CACHE_TTL_MIN=5
# BOOKING_RESOLVE_MAX_CONCURRENT=5
