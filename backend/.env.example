# ──────────────────────────────────────────────────────────────────────────────
# Fly-Fix Web — Backend Environment Variables
# Copy this file to .env and fill in your keys.
# ──────────────────────────────────────────────────────────────────────────────

# ─── Server ───────────────────────────────────────────────────────────────────
# Port the backend listens on (defaults to 8080 if not set)
PORT=8080

# ─── Google Flights2 (RapidAPI) — required for flight data ─────────────────────
# Subscribe to a "Google Flights2" style API on https://rapidapi.com and set:
GOOGLEFLIGHTS2_ENABLED=true
GOOGLEFLIGHTS2_RAPIDAPI_KEY=
GOOGLEFLIGHTS2_RAPIDAPI_HOST=google-flights2.p.rapidapi.com
# GOOGLEFLIGHTS2_ENDPOINT_PATH=        # Override the API path (advanced, rarely needed)
# Uses a 5 req/min rate limit and 10-minute cache by default.

# ─── Booking link mode ───────────────────────────────────────────────────────
# Controls how outbound booking URLs are generated.
# Options: "skyscanner" (default) | "direct" (link to airline sites directly)
# BOOKING_LINK_MODE=skyscanner

# ─── Affiliate tracking (optional) ──────────────────────────────────────────
# Used in outbound booking links for commission tracking.
# Set AFFILIATE_ID for a default; use per-provider overrides as needed.
# Do NOT commit real affiliate IDs to source control.
AFFILIATE_ID=
# AFF_ID_OTA=
# AFF_ID_LY=
# AFF_ID_UA=
# AFF_ID_AA=
# AFF_ID_BA=
# AFF_ID_LH=
# AFF_ID_TK=
# AFF_ID_EK=
# AFF_ID_DL=

# ─── Telegram bot (optional) ─────────────────────────────────────────────────
# If set, enables the Telegram bot interface for flight searches.
# Create a bot via https://t.me/BotFather to get a token.
# TELEGRAM_BOT_TOKEN=

# ─── RateHawk / ETG Hotel API (optional) ─────────────────────────────────────
# Official docs: https://docs.emergingtravel.com/
# Auth is HTTP Basic: RATEHAWK_KEY_ID (username) + RATEHAWK_API_KEY (password).
# Never expose these values to the frontend.
# RATEHAWK_ENABLED=true
# RATEHAWK_KEY_ID=
# RATEHAWK_API_KEY=
# RATEHAWK_BASE_URL=https://api.worldota.net
# Use https://api-sandbox.worldota.net for sandbox keys.
# RATEHAWK_RESIDENCY=us
# RATEHAWK_GEO_RADIUS_KM=25
# RATEHAWK_CACHE_TTL_SECONDS=300
# RATEHAWK_TIMEOUT_SECONDS=30
