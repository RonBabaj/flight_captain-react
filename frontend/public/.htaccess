# SPA fallback: serve index.html for client-side routes so refresh/back don't 404.
# Apache / LiteSpeed on Hostinger: mod_rewrite below.
# Nginx on Hostinger: .htaccess is NOT applied — use hostinger-nginx-spa.conf in hPanel
# AND deploy post-build copies (scripts/write-spa-fallbacks.mjs) for /search/results etc.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Legacy SPA paths → new structure (301, query string preserved)
  RewriteRule ^results/?$ /search/results [R=301,L,QSA]
  RewriteRule ^deals/?$ /monthly-deals/ [R=301,L,QSA]

  # If the request is for an existing file, serve it.
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]

  # If the request is for an existing directory, serve it.
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Otherwise rewrite to index.html (SPA root).
  RewriteRule ^ /index.html [L]
</IfModule>
