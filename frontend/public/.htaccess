# SPA fallback: serve index.html for client-side routes so refresh/back don't 404.
# Apache / LiteSpeed: mod_rewrite below.
# Nginx-based hosts ignore .htaccess — use an nginx `try_files` SPA fallback configuration if needed.
# AND deploy/build physical route shells (scripts/write-spa-fallbacks.mjs) for /search/results, /search/explore, etc.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Legacy SPA paths → new structure (301, query string preserved)
  RewriteRule ^results/?$ /search/results [R=301,L,QSA]
  RewriteRule ^deals/?$ /monthly-deals/ [R=301,L,QSA]

  # If the request is for an existing file, serve it.
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]

  # If the request is for an existing directory, serve it.
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Otherwise rewrite to index.html (SPA root).
  RewriteRule ^ /index.html [L]
</IfModule>
